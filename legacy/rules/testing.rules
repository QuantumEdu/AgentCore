# === TASKS ===

@pytest.fixture
def sample_task(db_session, sample_project, sample_subtask, admin_user):
    """Sample task for tests."""
    task = Task(
        project_id=sample_project.id,
        subtask_id=sample_subtask.id,
        quantity=1,
        assigned_to=admin_user.email,
        due_date=datetime(2026, 6, 30)
    )
    db_session.add(task)
    db_session.commit()
    db_session.refresh(task)
    return task
```

### Fixture rules:
- Scope `function` for isolation (default)
- Scope `session` only for immutable data
- Descriptive names: `sample_*`, `admin_user`, `auth_headers`
- Fixtures in `conftest.py` for reuse
- DO NOT use global fixtures with mutable state

## 3. API ENDPOINT TESTS

### Endpoint test template:
```python
# tests/test_projects_api.py
from fastapi import status

def test_create_project_success(client, auth_headers, admin_user):
    """
    Test: Create project successfully.

    Given: Authenticated user with permissions and valid data
    When: POST /api/v1/projects with valid payload
    Then: Returns 201 and the created project
    """
    payload = {
        "owner_id": admin_user.id,
        "project_type": "internal",
        "name": "New Feature Project",
        "description": "Developing the new onboarding flow",
        "budget_allocation": 5000.00
    }

    response = client.post("/api/v1/projects", json=payload, headers=auth_headers)

    assert response.status_code == status.HTTP_201_CREATED

    data = response.json()
    assert data["owner_id"] == admin_user.id
    assert data["status"] == "active"
    assert data["name"] == "New Feature Project"
    assert data["budget_allocation"] == 5000.00
    assert "created_at" in data

def test_create_project_name_already_exists(client, auth_headers, sample_project, admin_user):
    """
    Test: Reject project if owner already has one with same name.

    Given: Owner with existing project "FlowTask MVP"
    When: POST /api/v1/projects for same owner with same name
    Then: Returns 409 Conflict
    """
    payload = {
        "owner_id": admin_user.id,
        "project_type": "internal",
        "name": "FlowTask MVP",  # Already exists
        "budget_allocation": 0
    }

    response = client.post("/api/v1/projects", json=payload, headers=auth_headers)

    assert response.status_code == status.HTTP_409_CONFLICT
    assert "already" in response.json()["detail"].lower()

def test_create_project_unauthorized(client, admin_user):
    """
    Test: Reject creation without authentication.

    Given: Unauthenticated user
    When: POST /api/v1/projects
    Then: Returns 401 Unauthorized
    """
    payload = {
        "owner_id": admin_user.id,
        "project_type": "internal",
        "name": "Test Project",
        "budget_allocation": 0
    }

    response = client.post("/api/v1/projects", json=payload)  # No headers

    assert response.status_code == status.HTTP_401_UNAUTHORIZED

def test_get_project_success(client, auth_headers, sample_project):
    """
    Test: Get project by ID.

    Given: Existing project
    When: GET /api/v1/projects/{id}
    Then: Returns 200 and the project with task detail
    """
    response = client.get(f"/api/v1/projects/{sample_project.id}", headers=auth_headers)

    assert response.status_code == status.HTTP_200_OK

    data = response.json()
    assert data["id"] == sample_project.id
    assert data["name"] == sample_project.name

def test_get_project_not_found(client, auth_headers):
    """
    Test: GET non-existent project returns 404.
    """
    response = client.get("/api/v1/projects/99999", headers=auth_headers)

    assert response.status_code == status.HTTP_404_NOT_FOUND

def test_list_projects_filter_status(client, auth_headers, sample_project):
    """
    Test: Filter projects by status.
    """
    response = client.get("/api/v1/projects?status=active", headers=auth_headers)
    assert response.status_code == 200
    data = response.json()
    assert len(data["items"]) >= 1
    assert all(p["status"] == "active" for p in data["items"])
```

### AAA Pattern (Arrange-Act-Assert):
```python
def test_example():
    # ARRANGE - Prepare data
    project = create_project()

    # ACT - Execute action
    response = client.post("/api/v1/tasks", json={...})

    # ASSERT - Verify result
    assert response.status_code == 201
```

## 4. SERVICE/BUSINESS LOGIC TESTS

```python
# tests/test_budget.py
from app.services.activity_logs import calculate_budget_remaining

def test_calculate_budget_remaining_with_allocation_and_tasks(db_session, sample_project):
    """
    Test: budget_remaining = budget_allocation - budget_used.

    Budget allocation of 10000 + tasks = total_budget_used
    """
    # Register budget allocation log (credit)
    log_allocation = ActivityLog(
        project_id=sample_project.id,
        description="Initial budget allocation",
        budget_allocated=10000.00,
        timestamp=datetime.utcnow()
    )
    db_session.add(log_allocation)

    # Register task cost as budget used
    log_task = ActivityLog(
        project_id=sample_project.id,
        description="Feature: user auth (8h)",
        budget_used=800.00,
        timestamp=datetime.utcnow()
    )
    db_session.add(log_task)
    db_session.commit()

    remaining = calculate_budget_remaining(db_session, sample_project.id)

    # allocated=10000, used=800 → remaining = 10000 - 800 = 9200
    assert abs(remaining - 9200.00) < 0.01

def test_calculate_budget_remaining_no_activity(db_session, sample_project):
    """
    Test: Budget remaining equals allocation when no activity.
    """
    remaining = calculate_budget_remaining(db_session, sample_project.id)
    assert remaining == sample_project.budget_allocation
```

## 5. AUTHENTICATION TESTS

```python
# tests/test_auth.py
def test_login_success(client, admin_user):
    """Test: Successful login returns JWT token."""
    response = client.post("/api/v1/auth/login", json={
        "email": "admin@test.com",
        "password": "Admin123!"
    })

    assert response.status_code == 200
    data = response.json()
    assert "access_token" in data
    assert data["token_type"] == "bearer"

def test_login_wrong_password(client, admin_user):
    """Test: Login with wrong password returns 401."""
    response = client.post("/api/v1/auth/login", json={
        "email": "admin@test.com",
        "password": "WrongPassword"
    })

    assert response.status_code == 401

def test_login_user_not_found(client):
    """Test: Login with non-existent user returns 401."""
    response = client.post("/api/v1/auth/login", json={
        "email": "doesnotexist@test.com",
        "password": "Password123!"
    })

    assert response.status_code == 401

def test_protected_endpoint_without_token(client):
    """Test: Protected endpoint without token returns 401."""
    response = client.get("/api/v1/projects")  # No auth_headers

    assert response.status_code == 401

def test_protected_endpoint_with_invalid_token(client):
    """Test: Invalid token returns 401."""
    response = client.get("/api/v1/projects", headers={
        "Authorization": "Bearer invalid_token"
    })

    assert response.status_code == 401
```

## 6. AUTHORIZATION (RBAC) TESTS

```python
def test_create_activity_log_as_member_forbidden(client, db_session, sample_project):
    """
    Test: Member CANNOT create activity log entries (budget records) (403).

    Only admin can record budget activity.
    """
    # Create member user
    member = User(
        email="member2@test.com",
        password_hash=hash_password("Member123!"),
        full_name="Member Test",
        role=UserRole.MEMBER
    )
    db_session.add(member)
    db_session.commit()

    # Login as member
    response = client.post("/api/v1/auth/login", json={
        "email": "member2@test.com",
        "password": "Member123!"
    })
    token = response.json()["access_token"]
    headers = {"Authorization": f"Bearer {token}"}

    # Attempt to create activity log
    payload = {
        "project_id": sample_project.id,
        "description": "Unauthorized budget entry",
        "budget_used": 1000.00
    }

    response = client.post("/api/v1/activity-logs", json=payload, headers=headers)

    assert response.status_code == status.HTTP_403_FORBIDDEN
```

## 7. VALIDATION TESTS (Pydantic)

```python
def test_create_project_budget_negative(client, auth_headers, admin_user):
    """
    Test: Negative budget returns 422.
    """
    payload = {
        "owner_id": admin_user.id,
        "project_type": "internal",
        "name": "Invalid Budget Project",
        "budget_allocation": -5000.00  # Invalid
    }

    response = client.post("/api/v1/projects", json=payload, headers=auth_headers)

    assert response.status_code == 422
    errors = response.json()["detail"]
    assert any("budget_allocation" in str(error).lower() for error in errors)

def test_create_project_missing_field(client, auth_headers):
    """
    Test: Missing required field returns 422.
    """
    payload = {
        "owner_id": 1
        # Missing: project_type, name
    }

    response = client.post("/api/v1/projects", json=payload, headers=auth_headers)

    assert response.status_code == 422
```

## 8. APPEND-ONLY TABLE TESTS

```python
def test_activity_log_cannot_be_updated(client, auth_headers, db_session, sample_project):
    """
    Test: Activity logs are append-only, cannot be modified.
    """
    # Create activity log
    log = ActivityLog(
        project_id=sample_project.id,
        description="Initial allocation",
        budget_allocated=5000.00,
        timestamp=datetime.utcnow()
    )
    db_session.add(log)
    db_session.commit()
    db_session.refresh(log)

    # Attempt PATCH — must be rejected (405 or 404)
    response = client.patch(
        f"/api/v1/activity-logs/{log.id}",
        json={"description": "Modified"},
        headers=auth_headers
    )

    # No PATCH endpoint should exist for activity_logs
    assert response.status_code in [404, 405]

def test_activity_log_cannot_be_deleted(client, auth_headers, db_session, sample_project):
    """
    Test: Activity logs are append-only, cannot be deleted.
    """
    log = ActivityLog(
        project_id=sample_project.id,
        description="Budget used",
        budget_used=1000.00,
        timestamp=datetime.utcnow()
    )
    db_session.add(log)
    db_session.commit()
    db_session.refresh(log)

    # Attempt DELETE — must be rejected
    response = client.delete(
        f"/api/v1/activity-logs/{log.id}",
        headers=auth_headers
    )

    assert response.status_code in [404, 405]

def test_sprint_immutable_after_close(client, auth_headers, db_session):
    """
    Test: Sprint once closed cannot be modified.
    """
    # Close a sprint
    response = client.post(
        "/api/v1/sprints/2026-Q2-S1/close",
        json={"summary": "Sprint completed successfully"},
        headers=auth_headers
    )
    assert response.status_code == 200

    # Attempt to close again
    response = client.post(
        "/api/v1/sprints/2026-Q2-S1/close",
        json={"summary": "Duplicate close attempt"},
        headers=auth_headers
    )
    assert response.status_code == 409  # Already closed
```

## 9. COVERAGE

### Configuration (pytest.ini):
```ini
[pytest]
testpaths = tests
python_files = test_*.py
python_classes = Test*
python_functions = test_*
addopts =
    --cov=app
    --cov-report=term-missing
    --cov-report=html
    --cov-fail-under=80
```

### Run tests with coverage:
```bash
# All tests with coverage
pytest --cov=app --cov-report=term-missing

# Specific tests
pytest tests/test_projects_api.py -v

# With HTML report
pytest --cov=app --cov-report=html
# View at: htmlcov/index.html
```

### Coverage targets:
- Minimum global: 80%
- Critical endpoints (projects, activity_logs): 95%+
- Business services (budget, sprints): 90%+
- Utilities: 85%+

## 10. MARKERS (CATEGORIZATION)

```python
# tests/conftest.py
import pytest

def pytest_configure(config):
    config.addinivalue_line("markers", "slow: slow tests")
    config.addinivalue_line("markers", "integration: integration tests")
    config.addinivalue_line("markers", "unit: unit tests")

# Usage in tests
@pytest.mark.slow
def test_close_sprint_with_many_activity_logs():
    pass

@pytest.mark.integration
def test_full_project_task_sprint_flow():
    pass
```

### Run by category:
```bash
pytest -m unit          # Only unit tests
pytest -m "not slow"    # Exclude slow
pytest -m integration   # Only integration
```

## 11. PARAMETRIZATION

```python
@pytest.mark.parametrize("role,expected_status", [
    (UserRole.ADMIN, 201),
    (UserRole.MEMBER, 201),
    (UserRole.VIEWER, 403),
])
def test_create_project_permissions(client, db_session, role, expected_status, admin_user):
    """
    Test: Project creation permissions by role.
    Only admin and member can create projects.
    """
    user = User(
        email=f"{role.value}@test.com",
        password_hash=hash_password("Pass123!"),
        full_name=f"User {role.value}",
        role=role
    )
    db_session.add(user)
    db_session.commit()

    # Login
    response = client.post("/api/v1/auth/login", json={
        "email": f"{role.value}@test.com",
        "password": "Pass123!"
    })
    token = response.json()["access_token"]
    headers = {"Authorization": f"Bearer {token}"}

    # Create project
    payload = {
        "owner_id": user.id,
        "project_type": "internal",
        "name": f"Project by {role.value}",
        "budget_allocation": 0
    }

    response = client.post("/api/v1/projects", json=payload, headers=headers)
    assert response.status_code == expected_status

@pytest.mark.parametrize("role,expected_status", [
    (UserRole.ADMIN, 201),
    (UserRole.MEMBER, 403),
    (UserRole.VIEWER, 403),
])
def test_create_activity_log_permissions(client, db_session, role, expected_status, sample_project):
    """
    Test: Activity log creation permissions by role.
    Only admin can record budget activity.
    """
    user = User(
        email=f"{role.value}_log@test.com",
        password_hash=hash_password("Pass123!"),
        full_name=f"User {role.value}",
        role=role
    )
    db_session.add(user)
    db_session.commit()

    response = client.post("/api/v1/auth/login", json={
        "email": f"{role.value}_log@test.com",
        "password": "Pass123!"
    })
    token = response.json()["access_token"]
    headers = {"Authorization": f"Bearer {token}"}

    payload = {
        "project_id": sample_project.id,
        "description": "Budget entry",
        "budget_used": 500.00
    }

    response = client.post("/api/v1/activity-logs", json=payload, headers=headers)
    assert response.status_code == expected_status
```

## 12. VALIDATION CHECKLIST

Before approving tests:

- [ ] Tests in `test_*.py` file? → OK
- [ ] Reusable fixtures in conftest.py? → OK
- [ ] In-memory database per test? → OK
- [ ] Happy path tests (success)? → OK
- [ ] Validation tests (422)? → OK
- [ ] Error tests (404, 409)? → OK
- [ ] Authorization tests (401, 403)? → OK
- [ ] Append-only table tests (no PATCH/DELETE)? → OK
- [ ] Sprint immutability tests? → OK
- [ ] Coverage >= 80%? → OK
- [ ] Descriptive names? → OK
- [ ] AAA pattern (Arrange-Act-Assert)? → OK

